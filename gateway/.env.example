# SeeMind Gateway listens locally by default.
SEEMIND_GATEWAY_HOST=127.0.0.1
SEEMIND_GATEWAY_PORT=8787
SEEMIND_GATEWAY_TIMEOUT_MS=45000
SEEMIND_GATEWAY_MAX_BODY=3000000
SEEMIND_GATEWAY_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Teacher health / circuit breaker.
SEEMIND_TEACHER_FAILURE_THRESHOLD=2
SEEMIND_TEACHER_COOLDOWN_MS=30000

# Logical Teacher A. Keep secrets ONLY on the gateway/server machine.
SEEMIND_TEACHER_A_ENABLED=false
SEEMIND_TEACHER_A_PROTOCOL=openai-compatible
SEEMIND_TEACHER_A_ENDPOINT=https://YOUR_PROVIDER_ENDPOINT/v1
SEEMIND_TEACHER_A_MODEL=YOUR_MODEL
SEEMIND_TEACHER_A_API_KEY=YOUR_SECRET
SEEMIND_TEACHER_A_CAPABILITIES=reasoning,vision,structured_output
SEEMIND_TEACHER_A_LANGUAGES=auto,zh-CN,es-MX,en
SEEMIND_TEACHER_A_RELIABILITY=0.85
SEEMIND_TEACHER_A_EVIDENCE_SCORE=0.80
SEEMIND_TEACHER_A_FRESHNESS_SCORE=0.60
SEEMIND_TEACHER_A_LATENCY=medium
SEEMIND_TEACHER_A_COST=medium

# Repeat with SEEMIND_TEACHER_B_* and SEEMIND_TEACHER_C_* when needed.

# Optional current-information search provider (server-side only)
SEEMIND_SEARCH_ENABLED=false
SEEMIND_SEARCH_NAME=search-A
SEEMIND_SEARCH_ENDPOINT=
SEEMIND_SEARCH_API_KEY=
SEEMIND_SEARCH_TIMEOUT_MS=15000
